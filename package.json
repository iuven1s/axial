{
  "name": "axial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
